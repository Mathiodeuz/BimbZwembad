@using Zwemclub.ViewModels
@model RegistratieViewModel

@{
    ViewData["Title"] = "Registreren";
}

<h1>Registreren als @Model.Rol.ToLower()</h1>

<form asp-action="Register" method="post" enctype="mmultipart/form-data" class="mt-3" style="max-width: 480px;">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="Rol" />

    <div class="mb-3">
        <label asp-for="Voornaam" class="form-label">Voornaam</label>
        <input asp-for="Voornaam" class="form-control" autocomplete="given-name" />
        <span asp-validation-for="Voornaam" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Naam" class="form-label">Achternaam</label>
        <input asp-for="Naam" class="form-control" autocomplete="family-name" />
        <span asp-validation-for="Naam" class="text-danger"></span>
    </div>

    @if (Model.Rol == "Zwemmer")
    {
        <div class="mb-3">
            <label asp-for="Geboortedatum" class="form-label">Geboortedatum</label>
            <input asp-for="Geboortedatum" type="date" class="form-control" />
            <span asp-validation-for="Geboortedatum" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="GeslachtId" class="form-label">Geslacht</label>

            <select asp-for="GeslachtId" class="form-select">
                <option value="">-- Selecteer je geslacht --</option>
                <option value="1">Man</option>
                <option value="2">Vrouw</option>
                <option value="3">Andere</option>
            </select>

            <span asp-validation-for="GeslachtId" class="text-danger"></span>
        </div>
    }

    <div class="mb-3">
        <label asp-for="Email" class="form-label">E-mailadres</label>
        <input asp-for="Email" type="email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Telefoon" class="form-label">Gsm-nummer</label>
        <input asp-for="Telefoon" type="tel" class="form-control" autocomplete="tel" />
        <span asp-validation-for="Telefoon" class="text-danger"></span>
    </div>
    
    <div class="mb-3">
        <label asp-for="ProfielFoto" class="form-label">
            Profielfoto
        </label>

        <input asp-for="ProfielFoto"
               type="file"
               class="form-control"
               accept="image/*" />

        <span asp-validation-for="ProfielFoto"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Wachtwoord" class="form-label">Wachtwoord</label>
        <input asp-for="Wachtwoord" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Wachtwoord" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="BevestigWachtwoord" class="form-label">Bevestig wachtwoord</label>
        <input asp-for="BevestigWachtwoord" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="BevestigWachtwoord" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Volgende</button>
    <a asp-action="KiesRol" class="btn btn-link">Terug</a>
</form>

<p class="mt-3">
    Al een account? <a asp-action="Login">Meld je aan</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}