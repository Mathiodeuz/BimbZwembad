@{
    ViewData["Title"] = "Home";
}

<section class="py-5 my-3">
    <div class="container">
        <div class="row justify-content-center mb-5">
            <div class="col-lg-8 text-center">
                <h1 class="fw-bold mb-2">Welkom bij onze zwemclub!</h1>
                <h3 class="fw-bold text-primary mb-2">Wie zijn wij?</h3>
                <p class="text-secondary mb-0">
                    Wij zijn een hechte en familiale zwemclub waar zowel beginnende waterratten als doorgewinterde zwemmers zich meteen thuis voelen. Met een gedreven team van vrijwillige trainers zorgen we elke week voor veilige, leerrijke en vooral plezierige zwemmomenten voor het hele gezin.
                </p>
            </div>
        </div>

        <div class="p-4 p-md-5 mb-3 bg-info-subtle bg-opacity-25 border border-info-subtle rounded-4 shadow-sm text-center">
            <div class="col-lg-8 mx-auto py-3">
                <h2 class="display-6 fw-bold text-dark mb-3">
                    Duik mee met onze Zwemclub!
                </h2>
                <p class="lead text-secondary mb-4">
                    Van de eerste spetters in het peuterbad tot snelle baantjes bij de competitie. Bij ons draait alles om zwemplezier, veiligheid en samen groeien in een warme clubomgeving.
                </p>

                <!-- Link naar inschrijvings pagina invullen. -->
                <a href="/Inschrijven" class="btn btn-primary btn-lg px-5 rounded-pill shadow">
                    Inschrijven
                </a>
            </div>
        </div>
    </div>
</section>

<section class="py-4 mb-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="bg-light border-start border-4 border-primary rounded-end-4 p-4 p-md-5 shadow-sm">
                    <h2 class="fw-bold text-dark mb-3">Over onze zwemclub</h2>
                    <p class="text-muted mb-0">
                        De Zwemclub is al jaren een begrip voor jong en oud. Onder begeleiding van gediplomeerde en enthousiaste lesgevers leert iedereen op zijn of haar eigen tempo zwemmen. Plezier in het water staat bij ons altijd op nummer één.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>