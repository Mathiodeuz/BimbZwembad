@{
    ViewData["Title"] = "Contact";
}
@model Zwemclub.ViewModels.ContactViewModel

<div class="container pt-5 pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="text-center mb-4">
                <h1 class="fw-bold">Contacteer ons</h1>
                <p class="text-secondary fs-5 my-2">
                    Heb je een vraag over trainingen, wedstrijden of lidmaatschap? Stuur ons een bericht.
                </p>
            </div>

            @if (TempData["ContactSucces"] is string succesBericht)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
                    @succesBericht
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Sluiten"></button>
                </div>
            }

            <div class="card border-0 shadow-sm rounded-4 p-4">
                <form asp-controller="Contact" asp-action="Index" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>

                    <div class="d-none" aria-hidden="true">
                        <label asp-for="Website"></label>
                        <input asp-for="Website" tabindex="-1" autocomplete="off" />
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Naam" class="form-label fw-semibold"></label>
                            <input asp-for="Naam" class="form-control" placeholder="Jouw volledige naam" />
                            <span asp-validation-for="Naam" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="naam@voorbeeld.be" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Onderwerp" class="form-label fw-semibold"></label>
                            <input asp-for="Onderwerp" class="form-control" placeholder="Bijv. Proeftraining of wedstrijdinfo" />
                            <span asp-validation-for="Onderwerp" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Bericht" class="form-label fw-semibold"></label>
                            <textarea asp-for="Bericht" rows="5" class="form-control" placeholder="Schrijf hier je vraag of opmerking..."></textarea>
                            <span asp-validation-for="Bericht" class="text-danger small"></span>
                        </div>

                        <div class="col-12 d-flex justify-content-end mt-3">
                            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                                Bericht versturen
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}